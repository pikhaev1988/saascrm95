# Скопируйте в .env.deploy
DEPLOY_HOST=beget-analizgia
DEPLOY_PATH=/home/p/pikhae0x/analizgia.ru/public/analiz_gia
RESTART_FILE=/home/p/pikhae0x/analizgia.ru/tmp/restart.txt
GIT_BRANCH=main
# Интерпретатор на Beget (site-level venv, не системный python3)
PYTHON_BIN=/home/p/pikhae0x/analizgia.ru/venv/bin/python
# Каталог дампов БД перед migrate (создаётся автоматически)
BACKUP_DIR=/home/p/pikhae0x/backups/analiz_gia

# Обязательные production-параметры в .env на сервере:
# DEBUG=False
# SECRET_KEY=<long-random-secret>
# ALLOWED_HOSTS=analizgia.ru,www.analizgia.ru
# SERVE_MEDIA_FROM_DJANGO=False
