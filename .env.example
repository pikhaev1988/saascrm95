DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
USE_SQLITE=True
SERVE_MEDIA_FROM_DJANGO=True

# HTTPS and cookie hardening (recommended for production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY
CSRF_TRUSTED_ORIGINS=https://analizgia.ru,https://www.analizgia.ru
SESSION_COOKIE_DOMAIN=.analizgia.ru
CSRF_COOKIE_DOMAIN=.analizgia.ru

# Logging
AUDIT_LOG_LEVEL=INFO
REQUEST_LOG_LEVEL=INFO

DB_ENGINE=django.db.backends.postgresql
DB_NAME=analiz_gia
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# GigaChat — единственный провайдер ИИ (отчёты, сводки, обогащение тем в scripts/)
# Достаточно ключа авторизации ИЛИ пары client_id + client_secret:
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_AUTH_KEY=
# true / false; если не задано — включено при наличии учётных данных
GIGACHAT_ANALYSIS_ENABLED=
GIGACHAT_MODEL=GigaChat-Max
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_REQUEST_TIMEOUT=45
# На Windows часто нужно false, пока не установлен сертификат Минцифры
# В production рекомендуется true.
GIGACHAT_VERIFY_SSL_CERTS=false

# Кэш комплексного анализа ВПР (по умолчанию выключен; для Redis укажите CACHE_BACKEND)
VPR_ANALYSIS_CACHE_ENABLED=True
VPR_ANALYSIS_CACHE_TIMEOUT=3600
VPR_ANALYSIS_CACHE_ALIAS=default
# Пример Redis:
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1
